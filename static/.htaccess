# BrandCloud prototypes – Apache (Wedos). Everything is behind the login (/_sv/gate.php),
# except the design system files the login page needs (/ds/).
Options -Indexes
DirectoryIndex index.html
DirectorySlash Off

RewriteEngine On
RewriteBase /

# login, logout, uploader, api – run directly
RewriteRule ^_sv/(login|logout|admin|api|gate)\.php$ - [L]
# server internals (config, key, uploads registry) – never
RewriteRule ^_sv(/|$) - [F,L]
# public: design system (tokens, fonts css, logo, top bar) for the login page
RewriteRule ^ds/[^/]+$ - [L]
# everything else (pages, data, uploads, manifest) – only when logged in
RewriteRule ^ _sv/gate.php [L,QSA]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Robots-Tag "noindex, nofollow"
  <FilesMatch "\.(css|js|svg)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>
